{
  "project": {
    "name": {
      "title": "IPv6 Prefix Updater for pfSense",
      "slug": "pfsense-ipv6-prefix-updater"
    },
    "description": {
      "short": "Keep pfSense on your current IPv6 prefix when your ISP hands out a new one",
      "long": "Follow your ISP's new IPv6 prefix across interfaces, virtual IPs, aliases, firewall rules, NAT, DHCPv6, and the other pfSense fields you pick, keeping the host part of each address. Updates run on a schedule, back up first, and report their status and notifications in the WebGUI."
    },
    "keywords": [
      "pfsense",
      "pfsense-package",
      "ipv6",
      "dynamic-prefix",
      "firewall",
      "ipsec",
      "openvpn",
      "wireguard"
    ],
    "legalName": "Jacky Liang",
    "pronouns": "personal",
    "platforms": [
      "nodejs",
      "php",
      "pfsense",
      "web"
    ],
    "startingYear": 2023,
    "license": "MIT"
  },
  "entities": [
    {
      "name": "Jacky Liang",
      "email": "hello@mrjackyliang.com",
      "url": "https://www.mrjackyliang.com/",
      "roles": [
        "author"
      ]
    },
    {
      "name": "@wblew",
      "url": "https://github.com/wblew",
      "roles": [
        "contributor"
      ]
    }
  ],
  "emails": {
    "bugs": "bugs@mrjackyliang.com"
  },
  "github": {
    "owner": "mrjackyliang",
    "repo": "pfsense-ipv6-prefix-updater",
    "topics": [
      "pfsense",
      "pfsense-package",
      "ipv6",
      "dynamic-prefix",
      "firewall",
      "ipsec",
      "openvpn",
      "wireguard"
    ],
    "features": {
      "issues": true,
      "wiki": false,
      "projects": false,
      "discussions": false,
      "sponsorships": true
    },
    "policies": {
      "visibility": "public",
      "defaultBranch": "main",
      "mergeMethods": {
        "merge": true,
        "squash": true,
        "rebase": true
      },
      "mergeCommit": {
        "title": "merge-message",
        "message": "pull-request-title"
      },
      "squashMerge": {
        "title": "commit-or-pull-request-title",
        "message": "commit-messages"
      },
      "autoDeleteHeadBranch": true,
      "autoMerge": false,
      "allowUpdateBranch": false,
      "webCommitSignoffRequired": false
    },
    "security": {
      "vulnerabilityAlerts": true,
      "dependabotSecurityUpdates": false,
      "secretScanning": true,
      "pushProtection": true
    },
    "rulesets": {
      "defaultBranch": {
        "enforcement": "active",
        "blockDeletions": true,
        "blockForcePushes": true,
        "requireLinearHistory": false,
        "requireSignedCommits": true,
        "requirePullRequest": false,
        "requiredStatusChecks": [],
        "requireBranchesToBeUpToDate": false
      }
    },
    "actions": {
      "enabled": true,
      "allowedActions": "all",
      "shaPinningRequired": false,
      "defaultWorkflowPermissions": "read",
      "canApprovePullRequestReviews": false,
      "artifactRetentionDays": 7
    },
    "labels": [
      {
        "name": "bug",
        "color": "d73a4a",
        "description": "Something isn't working"
      },
      {
        "name": "documentation",
        "color": "0075ca",
        "description": "Improvements or additions to documentation"
      },
      {
        "name": "duplicate",
        "color": "cfd3d7",
        "description": "This issue or pull request already exists"
      },
      {
        "name": "enhancement",
        "color": "a2eeef",
        "description": "New feature or request"
      },
      {
        "name": "good first issue",
        "color": "7057ff",
        "description": "Good for newcomers"
      },
      {
        "name": "help wanted",
        "color": "008672",
        "description": "Extra attention is needed"
      },
      {
        "name": "invalid",
        "color": "e4e669",
        "description": "This doesn't seem right"
      },
      {
        "name": "question",
        "color": "d876e3",
        "description": "Further information is requested"
      },
      {
        "name": "wontfix",
        "color": "ffffff",
        "description": "This will not be worked on"
      }
    ],
    "issueTemplate": {
      "bugReportFields": [
        "pfsense",
        "pfsense-package",
        "web",
        "screenshots",
        "notifications"
      ],
      "customQuestions": {
        "bug": [
          {
            "type": "dropdown",
            "id": "configuration-area",
            "attributes": {
              "label": "Affected Configuration Area",
              "description": "Select the pfSense configuration area involved.",
              "options": [
                "Monitored Interface",
                "Virtual IP",
                "Alias",
                "Firewall Rule",
                "NAT",
                "DHCPv6",
                "IPsec",
                "OpenVPN",
                "WireGuard",
                "Schedule",
                "Backup or Restore",
                "Status or Notification",
                "Other"
              ]
            },
            "validations": {
              "required": true
            }
          },
          {
            "type": "input",
            "id": "prefix-length",
            "attributes": {
              "label": "Prefix Length",
              "description": "Enter only the configured prefix length from 48 through 64. Do not include the full prefix."
            },
            "validations": {
              "required": true
            }
          },
          {
            "type": "dropdown",
            "id": "run-result",
            "attributes": {
              "label": "Run Result",
              "description": "Select the reported updater result.",
              "options": [
                "No Change",
                "Success",
                "Warning",
                "Failure",
                "Not Sure"
              ]
            },
            "validations": {
              "required": false
            }
          }
        ],
        "feature": [
          {
            "type": "dropdown",
            "id": "configuration-area",
            "attributes": {
              "label": "Affected Configuration Area",
              "description": "Select the pfSense configuration area involved.",
              "options": [
                "Monitored Interface",
                "Virtual IP",
                "Alias",
                "Firewall Rule",
                "NAT",
                "DHCPv6",
                "IPsec",
                "OpenVPN",
                "WireGuard",
                "Schedule",
                "Backup or Restore",
                "Status or Notification",
                "Other"
              ]
            },
            "validations": {
              "required": true
            }
          }
        ],
        "support": [
          {
            "type": "dropdown",
            "id": "configuration-area",
            "attributes": {
              "label": "Affected Configuration Area",
              "description": "Select the pfSense configuration area involved.",
              "options": [
                "Monitored Interface",
                "Virtual IP",
                "Alias",
                "Firewall Rule",
                "NAT",
                "DHCPv6",
                "IPsec",
                "OpenVPN",
                "WireGuard",
                "Schedule",
                "Backup or Restore",
                "Status or Notification",
                "Other"
              ]
            },
            "validations": {
              "required": true
            }
          },
          {
            "type": "input",
            "id": "prefix-length",
            "attributes": {
              "label": "Prefix Length",
              "description": "Enter only the configured prefix length from 48 through 64. Do not include the full prefix."
            },
            "validations": {
              "required": true
            }
          },
          {
            "type": "dropdown",
            "id": "run-result",
            "attributes": {
              "label": "Run Result",
              "description": "Select the reported updater result.",
              "options": [
                "No Change",
                "Success",
                "Warning",
                "Failure",
                "Not Sure"
              ]
            },
            "validations": {
              "required": false
            }
          }
        ]
      }
    }
  },
  "workflows": [
    {
      "template": "check-sponsor-gated-issues",
      "name": "sponsor-check",
      "triggers": [
        "issue-comment",
        "issues"
      ],
      "runsOn": "ubuntu-24.04",
      "timeoutMinutes": 5
    },
    {
      "template": "lock-inactive-issues",
      "name": "lock-inactive",
      "triggers": [
        "schedule-weekly"
      ],
      "runsOn": "ubuntu-24.04",
      "timeoutMinutes": 5
    },
    {
      "template": "publish",
      "name": "project",
      "triggers": [
        "release"
      ],
      "runsOn": "ubuntu-24.04",
      "timeoutMinutes": 30,
      "build": [
        "./packages/ipv6-prefix-updater",
        "./apps/docs"
      ],
      "deploy": [
        {
          "to": "github-pages",
          "path": "./apps/docs",
          "artifact": "documentation"
        },
        {
          "to": "pfsense",
          "path": "./packages/ipv6-prefix-updater"
        }
      ]
    }
  ],
  "urls": {
    "homepage": "https://mrjackyliang.github.io/pfsense-ipv6-prefix-updater/",
    "repository": "git+https://github.com/mrjackyliang/pfsense-ipv6-prefix-updater.git",
