  "workspaces": {
    "./": {
      "name": "pfsense-ipv6-prefix-updater-project",
      "role": "project",
      "policy": "freezable"
    },
    "./packages/ipv6-prefix-updater": {
      "name": "pfsense-pkg-ipv6-prefix-updater",
      "role": "package",
      "policy": "trackable",
      "pfsense": {
        "comment": "IPv6 Prefix Updater package for pfSense"
      }
    },
    "./apps/docs": {
      "name": "pfsense-ipv6-prefix-updater-docs",
      "role": "docs",
      "policy": "freezable"
    }
  },
  "artifacts": {
    "documentation": {
      "build": [
        "./apps/docs"
      ],
      "sources": [
        {
          "from": "./apps/docs/build",
          "to": "./"
        }
      ]
    }
  },
