  "environment": {
    "project": {
      "prefix": "PROJECT_"
    },
    "workspaces": {
      "./": {
        "prefix": "ROOT_"
      },
      "./packages/ipv6-prefix-updater": {
        "prefix": "PFSENSE_"
      },
      "./apps/docs": {
        "prefix": "DOCS_"
      }
    },
    "workflows": {
