	 */
	]]>
	</copyright>
	<name>ipv6prefixupdater</name>
	<version>%%PKGVERSION%%</version>
	<title>Services: IPv6 Prefix Updater</title>
	<include_file>/usr/local/pkg/ipv6-prefix-updater.inc</include_file>
	<aftersaveredirect>/pkg_edit.php?xml=ipv6-prefix-updater.xml&amp;id=0&amp;savemsg=Settings%20saved.</aftersaveredirect>
	<menu>
		<name>IPv6 Prefix Updater</name>
		<section>Services</section>
		<configfile>ipv6-prefix-updater.xml</configfile>
		<url>/pkg_edit.php?xml=ipv6-prefix-updater.xml&amp;id=0</url>
	</menu>
	<tabs>
		<tab>
			<text>Settings</text>
			<url>/pkg_edit.php?xml=ipv6-prefix-updater.xml&amp;id=0</url>
			<active/>
		</tab>
		<tab>
			<text>Status</text>
			<url>/ipv6-prefix-updater-status.php</url>
		</tab>
		<tab>
			<text>Fields</text>
			<url>/ipv6-prefix-updater-fields.php</url>
		</tab>
		<tab>
			<text>Backups</text>
			<url>/ipv6-prefix-updater-backups.php</url>
		</tab>
		<tab>
			<text>Cleanup</text>
			<url>/ipv6-prefix-updater-cleanup.php</url>
		</tab>
	</tabs>
	<fields>
		<field>
			<type>listtopic</type>
			<name>Prefix Monitoring</name>
		</field>
		<field>
			<fielddescr>Enable Scheduled Updates</fielddescr>
			<fieldname>enabled</fieldname>
			<type>checkbox</type>
			<description>Check for prefix changes automatically. The first successful check records a baseline and never modifies configuration.</description>
		</field>
		<field>
			<fielddescr>Monitored Interfaces</fielddescr>
			<type>rowhelper</type>
			<rowhelper>
				<rowhelperfield>
					<fielddescr>Interface</fielddescr>
					<fieldname>interface</fieldname>
					<type>select</type>
					<width>3</width>
				</rowhelperfield>
				<rowhelperfield>
					<fielddescr>Delegated prefix length</fielddescr>
					<fieldname>prefix_length</fieldname>
					<type>select</type>
					<value>56</value>
					<width>2</width>
					<options>
						<option><name>/48</name><value>48</value></option>
						<option><name>/49</name><value>49</value></option>
						<option><name>/50</name><value>50</value></option>
						<option><name>/51</name><value>51</value></option>
						<option><name>/52</name><value>52</value></option>
						<option><name>/53</name><value>53</value></option>
						<option><name>/54</name><value>54</value></option>
						<option><name>/55</name><value>55</value></option>
						<option><name>/56</name><value>56</value></option>
						<option><name>/57</name><value>57</value></option>
						<option><name>/58</name><value>58</value></option>
						<option><name>/59</name><value>59</value></option>
						<option><name>/60</name><value>60</value></option>
						<option><name>/61</name><value>61</value></option>
						<option><name>/62</name><value>62</value></option>
						<option><name>/63</name><value>63</value></option>
						<option><name>/64</name><value>64</value></option>
					</options>
				</rowhelperfield>
			</rowhelper>
		</field>
		<field>
			<type>info</type>
			<description>Add one row per interface whose primary active global IPv6 address carries a delegated prefix. For prefix-only DHCPv6 on WAN, select a downstream tracked interface. Host bits after the prefix length are preserved exactly, and the address pfSense picks for each interface appears on the Status tab.</description>
		</field>
		<field>
			<fielddescr>Schedule</fielddescr>
			<fieldname>update_frequency</fieldname>
			<type>select</type>
			<default_value>hourly</default_value>
			<options>
				<option><name>Every 15 minutes</name><value>every_fifteen_minutes</value></option>
				<option><name>Hourly</name><value>hourly</value></option>
				<option><name>Every 6 hours</name><value>every_six_hours</value></option>
				<option><name>Daily at midnight</name><value>daily</value></option>
			</options>
			<description>Choose how often pfSense checks the active prefix. Unchanged checks do not scan or write approved fields.</description>
		</field>
		<field>
			<type>info</type>
			<description>Choose which configuration fields change with the prefix on the Fields tab.</description>
		</field>
		<field>
			<type>listtopic</type>
			<name>Notifications</name>
		</field>
		<field>
			<fielddescr>Send Change Notifications</fielddescr>
			<fieldname>notifications</fieldname>
			<type>checkbox</type>
			<default_value>on</default_value>
			<description>Use configured pfSense notification channels after a verified successful prefix update. No-op checks never notify.</description>
		</field>
	</fields>
	<custom_php_install_command>
		pfsensePackageIpv6PrefixUpdaterSync();
	</custom_php_install_command>
	<custom_php_resync_config_command>
		pfsensePackageIpv6PrefixUpdaterSync();
	</custom_php_resync_config_command>
	<custom_php_deinstall_command>
		pfsensePackageIpv6PrefixUpdaterRemove();
	</custom_php_deinstall_command>
	<custom_delete_php_command>
		pfsensePackageIpv6PrefixUpdaterRemove();
	</custom_delete_php_command>
	<custom_php_validation_command>
		pfsensePackageIpv6PrefixUpdaterValidate($_POST, $input_errors);
	</custom_php_validation_command>
	<custom_php_command_before_form>
		pfsensePackageIpv6PrefixUpdaterLocalizePackageGui($pkg);
	</custom_php_command_before_form>
</packagegui>
